# Used by drizzle-kit (npm run db:generate / db:migrate / db:studio),
# which runs as a plain Node CLI outside the Workers runtime.
# Copy this file to .env.local and fill in the values.
NEON_DATABASE_URL=

# Client-side map config for /kart - read at build time via
# process.env.NEXT_PUBLIC_*, so these must be set wherever `next build` /
# `npm run cf:build` actually runs (including CI/deploy), not just locally.
# See CLAUDE.md "kart (map) env vars".
NEXT_PUBLIC_MAP_PROVIDER=maplibre
NEXT_PUBLIC_MAPTILER_API_KEY=

# Client-side map config for /solkalkulator - same mechanism, separate key
# (ported from balcony-sun's own VITE_MAPTILER_KEY).
NEXT_PUBLIC_MAPTILER_KEY=
